#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
) {
    bool physics:rigidBodyEnabled = true
    float physics:mass = 0.09
    point3f physics:centerOfMass = (0, 0, 0.08)
    float3 physics:diagonalInertia = (0.00011, 0.00011, 9e-06)
    def Scope "Looks" {
        def Material "Steel" {
            token outputs:surface.connect = </Asset/Looks/Steel/PBR.outputs:surface>
            def Shader "PBR" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.44, 0.47, 0.5)
                float inputs:metallic = 0.85
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }
        def Material "Grip" {
            token outputs:surface.connect = </Asset/Looks/Grip/PBR.outputs:surface>
            def Shader "PBR" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.25, 0.04)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }
    }
    def Mesh "HexTip" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI", "PhysicsMeshCollisionAPI"]
    ) {
        bool physics:collisionEnabled = true
        float physxCollision:contactOffset = 2.5e-05
        float physxCollision:restOffset = 0
        rel material:binding = </Asset/Looks/Steel>
        uniform token subdivisionScheme = "none"
        uniform token physics:approximation = "convexHull"
        point3f[] points = [(0.0022805335633, 0, 0), (0.00114026678165, 0.001975, 0), (-0.00114026678165, 0.001975, 0), (-0.0022805335633, 2.79284812864e-19, 0), (-0.00114026678165, -0.001975, 0), (0.00114026678165, -0.001975, 0), (0.0022805335633, 0, 0.018), (0.00114026678165, 0.001975, 0.018), (-0.00114026678165, 0.001975, 0.018), (-0.0022805335633, 2.79284812864e-19, 0.018), (-0.00114026678165, -0.001975, 0.018), (0.00114026678165, -0.001975, 0.018)]
        int[] faceVertexCounts = [6, 6, 4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [5, 4, 3, 2, 1, 0, 6, 7, 8, 9, 10, 11, 0, 1, 7, 6, 1, 2, 8, 7, 2, 3, 9, 8, 3, 4, 10, 9, 4, 5, 11, 10, 5, 0, 6, 11]
    }
    def Cylinder "Shaft" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    ) {
        bool physics:collisionEnabled = true
        float physxCollision:contactOffset = 2.5e-05
        float physxCollision:restOffset = 0
        rel material:binding = </Asset/Looks/Steel>
        double3 xformOp:translate = (0, 0, 0.0465)
        double radius = 0.003
        double height = 0.057
        uniform token axis = "Z"
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cube "Grip" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    ) {
        bool physics:collisionEnabled = true
        float physxCollision:contactOffset = 2.5e-05
        float physxCollision:restOffset = 0
        rel material:binding = </Asset/Looks/Grip>
        double3 xformOp:translate = (0, 0, 0.1)
        double size = 1
        double3 xformOp:scale = (0.024, 0.024, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
