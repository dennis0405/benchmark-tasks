        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Tool/surface55>
        custom float physxCollision:contactOffset = 0.0007
        custom float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.78, 0.46, 0.16)]
        double size = 1
        float3 xformOp:scale = (0.09248, 0.018, 0.014)
        double3 xformOp:translate = (0, 0, 0.043)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

