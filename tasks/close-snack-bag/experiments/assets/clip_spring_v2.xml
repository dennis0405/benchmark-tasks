<mujoco model="snack_clip">
  <compiler angle="radian" balanceinertia="true"/>
  <default><geom type="box" friction=".6 .005 .0001" rgba=".16 .32 .65 1"/></default>
  <worldbody>
    <body name="snack_clip">
      <freejoint name="clip_free"/>
      <geom name="lower_jaw" pos=".022 0 -.004" size=".022 .05 .003" mass=".008"/>
      <geom name="lower_handle" pos="-.015 0 -.008" size=".015 .012 .003" mass=".004"/>
      <body name="upper">
        <joint name="clip_hinge" type="hinge" axis="0 1 0" range="-.27 .02"
               stiffness=".2" springref="0" damping=".01"/>
        <geom name="upper_jaw" pos=".022 0 .004" size=".022 .05 .003" mass=".008"/>
        <geom name="upper_handle" pos="-.015 0 .008" size=".015 .012 .003" mass=".004"/>
      </body>
    </body>
  </worldbody>
</mujoco>
