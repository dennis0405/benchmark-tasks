#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.5.0"
    }
    defaultPrim = "paperclip_v3"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "paperclip_v3" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Geometry"
    {
        over "paperclip" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
        }
    }
}
