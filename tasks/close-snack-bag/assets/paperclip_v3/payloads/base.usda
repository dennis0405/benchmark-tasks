                uniform token axis = "Z"
                float3[] extent = [(-0.0008, -0.0008, -0.0128), (0.0008, 0.0008, 0.0128)]
                double height = 0.024
                rel material:binding:physics = </paperclip_v3/Physics/PhysicsMaterial>
                uniform double[] mjc:solref = [0.02, 1]
                float newton:contactGap = 0
                float physics:mass = 0.0002
                color3f[] primvars:displayColor = [(0.65, 0.66, 0.69)] (
                    interpolation = "constant"
                )
                int[] primvars:displayColor:indices = None
                float[] primvars:displayOpacity = [1] (
                    interpolation = "constant"
                )
                int[] primvars:displayOpacity:indices = None
                double radius = 0.0008
                quatf xformOp:orient = (0.7071068, 0, 0.7071067, 0)
                float3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, -0.005, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

