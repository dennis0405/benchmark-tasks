#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.5.0"
    }
    defaultPrim = "paperclip_v3"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./robot.usda@
    ]
    upAxis = "Z"
)

def Xform "paperclip_v3" (
    prepend apiSchemas = ["GeomModelAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "IsaacRobotAPI"]
    assetInfo = {
        string name = "paperclip_v3"
    }
    kind = "component"
)
{
    float3[] extentsHint = [(-0.0128, -0.0058, -0.0008000017), (0.012800001, 0.0058, 0.0008000017)]
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks
    custom token isaac:robotType = "Default"
