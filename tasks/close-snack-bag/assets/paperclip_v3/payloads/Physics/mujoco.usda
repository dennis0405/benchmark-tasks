#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.5.0"
    }
    defaultPrim = "paperclip_v3"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "paperclip_v3"
{
    over "Geometry"
    {
        over "paperclip"
        {
            over "wire0" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform double[] mjc:solref = [0.02, 1]
                float newton:contactGap = 0
            }

            over "wire1" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform double[] mjc:solref = [0.02, 1]
                float newton:contactGap = 0
            }

            over "wire2" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform double[] mjc:solref = [0.02, 1]
                float newton:contactGap = 0
            }

            over "wire3" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform double[] mjc:solref = [0.02, 1]
                float newton:contactGap = 0
            }

            over "wire4" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform double[] mjc:solref = [0.02, 1]
                float newton:contactGap = 0
            }
        }
    }
}
