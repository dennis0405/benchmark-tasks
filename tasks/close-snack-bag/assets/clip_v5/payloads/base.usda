#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.5.0"
    }
    defaultPrim = "clip_v5"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./robot.usda@
    ]
    upAxis = "Z"
)

def Xform "clip_v5" (
    prepend apiSchemas = ["GeomModelAPI", "IsaacRobotAPI"]
    assetInfo = {
        string name = "clip_v5"
    }
    kind = "component"
)
{
    float3[] extentsHint = [(-0.036, -0.05, -0.011), (0.044, 0.05, 0.011)]
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks
    custom token isaac:robotType = "Default"

    def Scope "Geometry"
    {
        def Xform "clip" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            def Cube "lower_jaw" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                float3[] extent = [(-1, -1, -1), (1, 1, 1)]
                rel material:binding:physics = </clip_v5/Physics/PhysicsMaterial>
                color3f[] primvars:displayColor = [(0.12, 0.38, 0.78)] (
                    interpolation = "constant"
                )
                int[] primvars:displayColor:indices = None
                float[] primvars:displayOpacity = [1] (
                    interpolation = "constant"
                )
                int[] primvars:displayOpacity:indices = None
                double size = 2
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.022, 0.05, 0.003)
                double3 xformOp:translate = (0.022, 0, -0.004)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "lower_handle" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                float3[] extent = [(-1, -1, -1), (1, 1, 1)]
                rel material:binding:physics = </clip_v5/Physics/PhysicsMaterial>
                color3f[] primvars:displayColor = [(0.12, 0.38, 0.78)] (
                    interpolation = "constant"
                )
                int[] primvars:displayColor:indices = None
                float[] primvars:displayOpacity = [1] (
                    interpolation = "constant"
                )
                int[] primvars:displayOpacity:indices = None
                double size = 2
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.018, 0.012, 0.003)
                double3 xformOp:translate = (-0.018, 0, -0.008)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Xform "upper" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                def Cube "upper_jaw" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
                )
                {
                    float3[] extent = [(-1, -1, -1), (1, 1, 1)]
                    rel material:binding:physics = </clip_v5/Physics/PhysicsMaterial>
                    color3f[] primvars:displayColor = [(0.19, 0.51, 0.92)] (
                        interpolation = "constant"
                    )
                    int[] primvars:displayColor:indices = None
                    float[] primvars:displayOpacity = [1] (
                        interpolation = "constant"
                    )
                    int[] primvars:displayOpacity:indices = None
                    double size = 2
                    quatf xformOp:orient = (1, 0, 0, 0)
                    float3 xformOp:scale = (0.022, 0.05, 0.003)
                    double3 xformOp:translate = (0.022, 0, 0.004)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                }

                def Cube "upper_handle" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
                )
                {
                    float3[] extent = [(-1, -1, -1), (1, 1, 1)]
                    rel material:binding:physics = </clip_v5/Physics/PhysicsMaterial>
                    color3f[] primvars:displayColor = [(0.19, 0.51, 0.92)] (
                        interpolation = "constant"
                    )
                    int[] primvars:displayColor:indices = None
                    float[] primvars:displayOpacity = [1] (
                        interpolation = "constant"
                    )
                    int[] primvars:displayOpacity:indices = None
                    double size = 2
                    quatf xformOp:orient = (1, 0, 0, 0)
                    float3 xformOp:scale = (0.018, 0.012, 0.003)
                    double3 xformOp:translate = (-0.018, 0, 0.008)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                }
            }
        }
    }

    def Scope "Physics"
    {
        def Material "PhysicsMaterial"
        {
        }
    }
}
