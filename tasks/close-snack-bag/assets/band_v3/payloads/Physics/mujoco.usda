#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.5.0"
    }
    defaultPrim = "band_v3"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "band_v3"
{
    over "Geometry"
    {
        over "band"
        {
            over "segment0" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform double[] mjc:solref = [0.02, 1]
                float newton:contactGap = 0
            }

