#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.5.0"
    }
    defaultPrim = "bag_v4"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "bag_v4" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Geometry"
    {
        over "bag" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "bag_flap" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "fold" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "bag_flap_end" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "fold2" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }
                }
            }
        }
    }
}
