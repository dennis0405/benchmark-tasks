    def Material "test_card_material"
    {
        token outputs:surface.connect = </Hydro/test_card_material/surface.outputs:surface>

        def Shader "surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Hydro/test_card_material/tex.outputs:rgb>
            float inputs:roughness = 0.8
            token outputs:surface
