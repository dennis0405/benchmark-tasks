"""Bounded native probe for an annular washer collision bore.

Two physically separate cells use the same dynamic 8 mm-clear-bore annulus.
A 6 mm pin must fall through the bore and a 10 mm pin must be supported by
washer contact.  This discovers only the compound-collider construction and
filtered-contact behavior; it does not qualify the final segmented washer,
breakable joints, screen retention, or any robot task.
"""

from __future__ import annotations

import argparse
import gzip
import json
import math
from pathlib import Path

from isaaclab.app import AppLauncher

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--physics-hz", type=int, choices=(240, 480), required=True)
parser.add_argument("--seconds", type=float, default=4.0)
parser.add_argument("--report", type=Path, required=True)
AppLauncher.add_app_launcher_args(parser)
args = parser.parse_args()
launcher = AppLauncher(args)
simulation_app = launcher.app

import numpy as np
import torch
import trimesh
from pxr import Gf, Usd, UsdGeom, UsdPhysics

import isaaclab.sim as sim_utils
from isaaclab.assets import RigidObject, RigidObjectCfg
