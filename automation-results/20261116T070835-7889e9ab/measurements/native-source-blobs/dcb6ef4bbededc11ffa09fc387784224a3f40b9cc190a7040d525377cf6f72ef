"""Bounded native probe for crossing classification in a moving screen frame.

This preflight asks one question only: can a finite oblique ceramic medium
that is initially bridged across one 12.7 mm aperture be released by a physically
driven revolute aperture, with a physics-sample geometric crossing classified
in the observed aperture frame?  Endpoint displacement and PhysX CCD state are
reported only as sampled diagnostics; they do not establish inter-sample or
exact rotational continuous collision coverage.  It is not the frozen 20-seed
bridge qualification, the full screen, a scorer, or a robot demonstration.
"""
from __future__ import annotations

import argparse, gzip, json, math
from pathlib import Path
from isaaclab.app import AppLauncher

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--physics-hz", type=int, choices=(240, 480), required=True)
parser.add_argument("--report", type=Path, required=True)
AppLauncher.add_app_launcher_args(parser)
args = parser.parse_args()
launcher = AppLauncher(args)
simulation_app = launcher.app

import numpy as np
import trimesh
from pxr import Gf, PhysxSchema, Sdf, UsdGeom, UsdPhysics
import isaaclab.sim as sim_utils
from isaaclab.app.settings_manager import get_settings_manager
from isaaclab.assets import RigidObject, RigidObjectCfg
from isaaclab.sensors import ContactSensor, ContactSensorCfg
from isaaclab.sim.spawners.meshes.meshes import _spawn_mesh_geom_from_mesh
from isaaclab.sim.utils import get_current_stage

APERTURE, PATCH, FLOOR_T = 0.0127, 0.050, 0.003
MEDIA_D, MEDIA_L, DENSITY = 0.009525, 0.022225, 2500.0
ROOT_Z, ROOT_MASS = 0.25, 0.40


def material():
    return sim_utils.RigidBodyMaterialCfg(static_friction=0.50, dynamic_friction=0.35, restitution=0.05)


def collision():
    return sim_utils.CollisionPropertiesCfg(contact_offset=0.00015, rest_offset=0.0)


def media_mesh():
    r, slope, n = MEDIA_D / 2, math.tan(math.radians(15)), 32
    length = MEDIA_L - 2 * r * slope
    vertices, faces = [], []
    for sign in (-1, 1):
        for i in range(n):
            a = 2 * math.pi * i / n
            x, y = r * math.cos(a), r * math.sin(a)
            vertices.append((x, y, slope * x + sign * length / 2))
    for i in range(1, n - 1):
        faces.extend(((0, i + 1, i), (n, n + i, n + i + 1)))
    for i in range(n):
        j = (i + 1) % n
        faces.extend(((i, j, n + j), (i, n + j, n + i)))
    return trimesh.Trimesh(vertices=vertices, faces=faces, process=True)


def spawn_mesh(mesh):
    def fn(path, cfg, translation=None, orientation=None, **kwargs):
        stage = get_current_stage()
        _spawn_mesh_geom_from_mesh(path, cfg, mesh, translation, orientation, stage=stage)
        prim = stage.GetPrimAtPath(path)
        # RigidBodyPropertiesCfg in the pinned Isaac Lab has no enable_ccd
        # constructor field. Author the native PhysX attribute explicitly,
        # as is already done for the moving aperture below.
        PhysxSchema.PhysxRigidBodyAPI.Apply(prim).CreateEnableCCDAttr(True)
        # This custom spawner calls the low-level mesh authoring helper
        # directly, so the normal spawn wrapper never gets a chance to apply
        # PhysxContactReportAPI.  ContactSensor initialization requires that
        # API on the rigid-body prim (putting activate_contact_sensors=True on
        # the MeshCfg alone is insufficient on this path).
        sim_utils.activate_contact_sensors(path, stage=stage)
        api = UsdPhysics.MassAPI.Apply(prim)
        api.CreateMassAttr(float(mesh.volume * DENSITY))
        api.CreateCenterOfMassAttr(Gf.Vec3f(*map(float, mesh.center_mass)))
        inertia = mesh.moment_inertia * DENSITY
        vals, axes = np.linalg.eigh(inertia)
        if np.linalg.det(axes) < 0: axes[:, 0] *= -1
        tf = np.eye(4); tf[:3, :3] = axes
        qw, qx, qy, qz = trimesh.transformations.quaternion_from_matrix(tf)
        api.CreateDiagonalInertiaAttr(Gf.Vec3f(*map(float, vals)))
        api.CreatePrincipalAxesAttr(Gf.Quatf(float(qw), Gf.Vec3f(float(qx), float(qy), float(qz))))
        return stage.GetPrimAtPath(path)
    return sim_utils.MeshCfg(func=fn,
        rigid_props=sim_utils.RigidBodyPropertiesCfg(solver_position_iteration_count=32,
            solver_velocity_iteration_count=8, max_depenetration_velocity=2.0),
        mass_props=None, collision_props=collision(), physics_material=material(),
        activate_contact_sensors=True,
        visual_material=sim_utils.PreviewSurfaceCfg(diffuse_color=(0.75, 0.55, 0.20)))


def spawn_moving_aperture():
    stage = get_current_stage()
    root = UsdGeom.Xform.Define(stage, "/World/MovingAperture")
    root.AddTranslateOp().Set(Gf.Vec3d(0, 0, ROOT_Z))
    UsdPhysics.RigidBodyAPI.Apply(root.GetPrim())
    PhysxSchema.PhysxRigidBodyAPI.Apply(root.GetPrim()).CreateEnableCCDAttr(True)
    UsdPhysics.MassAPI.Apply(root.GetPrim()).CreateMassAttr(ROOT_MASS)
    # Raw tensor contacts require reporting on the rigid-body root.  The four
    # ribs are collision children and are distinguished below by their actual
    # 3-D geometry in the observed moving root frame.
    sim_utils.activate_contact_sensors("/World/MovingAperture", stage=stage)
    side = (PATCH - APERTURE) / 2
    specs = (((side, PATCH, FLOOR_T), (-(APERTURE+side)/2, 0, -FLOOR_T/2)),
             ((side, PATCH, FLOOR_T), ((APERTURE+side)/2, 0, -FLOOR_T/2)),
             ((APERTURE, side, FLOOR_T), (0, -(APERTURE+side)/2, -FLOOR_T/2)),
             ((APERTURE, side, FLOOR_T), (0, (APERTURE+side)/2, -FLOOR_T/2)))
    for i, (size, pos) in enumerate(specs):
        cfg = sim_utils.CuboidCfg(size=size, collision_props=collision(), physics_material=material(),
            visual_material=sim_utils.PreviewSurfaceCfg(diffuse_color=(0.30, 0.38, 0.45)))
        cfg.func(f"/World/MovingAperture/Rib_{i}", cfg, translation=pos)
    joint = UsdPhysics.RevoluteJoint.Define(stage, "/World/MovingApertureHinge")
    joint.CreateAxisAttr("X")
    joint.CreateBody1Rel().SetTargets([Sdf.Path("/World/MovingAperture")])
    joint.CreateLocalPos0Attr(Gf.Vec3f(0, 0, ROOT_Z))
    joint.CreateLocalPos1Attr(Gf.Vec3f(0, 0, 0))
    joint.CreateLowerLimitAttr(-6.0); joint.CreateUpperLimitAttr(6.0)
    drive = UsdPhysics.DriveAPI.Apply(joint.GetPrim(), "angular")
    drive.CreateTypeAttr("force"); drive.CreateStiffnessAttr(500.0)
    drive.CreateDampingAttr(20.0); drive.CreateMaxForceAttr(50.0)
    drive.CreateTargetPositionAttr(0.0)
    return root, drive


def pose(body):
    p = body.data.root_pos_w.torch[0].detach().cpu().numpy().astype(float)
    q = body.data.root_quat_w.torch[0].detach().cpu().numpy().astype(float)
    v = body.data.root_vel_w.torch[0].detach().cpu().numpy().astype(float)
    return p, q, v


def world_vertices(body, mesh):
    p, q, _ = pose(body); x, y, z, w = q
    rot = trimesh.transformations.quaternion_matrix((w, x, y, z))[:3, :3]
    return mesh.vertices @ rot.T + p


def to_local_pose(position, quaternion_xyzw, points):
    x, y, z, w = quaternion_xyzw
    rotation = trimesh.transformations.quaternion_matrix((w, x, y, z))[:3, :3]
    return (np.asarray(points) - np.asarray(position)) @ rotation


def derived_hinge_state(position, quaternion_xyzw):
    """Derive world-to-body hinge state from native pose and authored frames."""
    x, y, z, w = map(float, quaternion_xyzw)
    rotation = trimesh.transformations.quaternion_matrix((w, x, y, z))[:3, :3]
    angle = math.degrees(math.atan2(float(rotation[2, 1]), float(rotation[2, 2])))
    axis_residual = math.degrees(math.acos(float(np.clip(rotation[0, 0], -1.0, 1.0))))
    # Body0 anchor is (0,0,ROOT_Z); Body1's authored anchor is its local origin.
    anchor_world = np.asarray(position, dtype=float) + rotation @ np.zeros(3)
    translation_residual = float(np.linalg.norm(anchor_world - np.array((0.0, 0.0, ROOT_Z))))
    return angle, translation_residual, axis_residual


def raw_rib_contacts(sensor, aperture_position, aperture_quaternion, capacity):
    """Map current raw pair contacts into the *observed* moving rib boxes.

    The native buffers are Warp arrays, so this uses their documented numpy()
    transfer.  A point establishes support only if every populated field is
    finite, its scalar normal force is positive, and its 3-D point uniquely
    matches one authored rib face in the current native aperture frame.
    """
    raw_force, raw_points, raw_normals, raw_separations, counts, starts = \
        sensor.contact_view.get_contact_data(1.0 / args.physics_hz)
    force_np, points_np = raw_force.numpy(), raw_points.numpy()
    normals_np, separations_np = raw_normals.numpy(), raw_separations.numpy()
    counts_np, starts_np = counts.numpy(), starts.numpy()
    count, start = int(counts_np[0, 0]), int(starts_np[0, 0])
    if start < 0 or count < 0 or start + count > int(points_np.shape[0]):
        raise RuntimeError(f"invalid raw contact slice start={start} count={count} capacity={points_np.shape[0]}")
    side = (PATCH - APERTURE) / 2
    specs = [
        (np.array((-(APERTURE+side)/2, 0.0, -FLOOR_T/2)), np.array((side, PATCH, FLOOR_T))),
        (np.array(((APERTURE+side)/2, 0.0, -FLOOR_T/2)), np.array((side, PATCH, FLOOR_T))),
        (np.array((0.0, -(APERTURE+side)/2, -FLOOR_T/2)), np.array((APERTURE, side, FLOOR_T))),
        (np.array((0.0, (APERTURE+side)/2, -FLOOR_T/2)), np.array((APERTURE, side, FLOOR_T))),
    ]
    rib_names = [f"/World/MovingAperture/Rib_{i}" for i in range(4)]
    points = points_np[start:start+count].astype(float)
    forces = force_np[start:start+count].astype(float)
    normals = normals_np[start:start+count].astype(float)
    separations = separations_np[start:start+count].reshape(-1).astype(float)
    support_ids, support_forces = set(), [0.0] * 4
    point_counts, contacts = {name: 0 for name in rib_names}, []
    accounting = {"total": count, "unique": 0, "ambiguous": 0, "unmapped": 0,
                  "positive_force": 0, "zero_force": 0, "invalid_contacts": 0,
                  "invalid_fields": 0, "saturated": int(count >= capacity)}
    local_points = to_local_pose(aperture_position, aperture_quaternion, points) if count else np.empty((0, 3))
    for point, local, force, normal, separation in zip(
            points, local_points, forces, normals, separations, strict=True):
        finite = [np.all(np.isfinite(point)), np.all(np.isfinite(force)),
                  np.all(np.isfinite(normal)), np.isfinite(separation)]
        invalid_fields = sum(not bool(value) for value in finite)
        accounting["invalid_fields"] += invalid_fields
        accounting["invalid_contacts"] += int(invalid_fields > 0)
        candidates = []
        for rib_id, (center, size) in enumerate(specs):
            half, offset = size / 2, np.abs(local - center)
            if (not invalid_fields and np.all(offset <= half + 5.0e-4)
                    and float(np.min(np.abs(offset-half))) <= 5.0e-4):
                candidates.append(rib_id)
        values = np.asarray(force).reshape(-1)
        if values.size != 1:
            raise RuntimeError(f"unexpected raw normal-force shape {values.shape}")
        normal_force = float(values[0])
        positive = bool(np.isfinite(normal_force) and normal_force > 1.0e-9)
        classification = "unique" if len(candidates) == 1 else ("ambiguous" if candidates else "unmapped")
        accounting[classification] += 1
        accounting["positive_force" if positive else "zero_force"] += 1
        mapped = candidates[0] if len(candidates) == 1 else None
        if mapped is not None and positive:
            support_ids.add(mapped)
            support_forces[mapped] += normal_force
            point_counts[rib_names[mapped]] += 1
        safe = lambda values: [float(v) if np.isfinite(v) else None
                               for v in np.asarray(values).reshape(-1)]
        contacts.append({"point_w_m": safe(point), "point_aperture_m": safe(local),
                         "normal_w": safe(normal),
                         "separation_m": float(separation) if np.isfinite(separation) else None,
                         "normal_force_N": normal_force if np.isfinite(normal_force) else None,
                         "positive_force": positive,
                         "finite_fields":{"point":bool(finite[0]), "force":bool(finite[1]),
                                          "normal":bool(finite[2]), "separation":bool(finite[3])},
                         "classification": classification,
                         "candidate_rib_ids": candidates,
                         "support_rib_id": mapped if positive else None})
    contacted = [rib_names[i] for i in sorted(support_ids)]
    return contacted, support_forces, point_counts, contacts, accounting, str(raw_points.device)


class Crossing:
    def __init__(self, vertices, faces):
        self.previous, self.faces, self.xy = np.asarray(vertices), np.asarray(faces), []
        self.armed = False
        self.arm_step = None
        self.arm_margin_m = None
        self.arm_support_loss_window = []
        self.attempt_id = 0
        self.invalidated_attempts = []
        self.maximum_step_motion = 0.0
        # A qualified bridge necessarily intersects the floor plane.  Requiring
        # every vertex to start above it made completion unreachable for the
        # exact state this probe is intended to classify.
        self.started_in_bridge_state = bool(np.max(self.previous[:, 2]) > 0 and
                                            np.min(self.previous[:, 2]) <= 0.001)

    def section_margin(self, vertices):
        """Minimum signed square-aperture margin of a sampled mesh section."""
        points = []
        vertices = np.asarray(vertices)
        for face in self.faces:
            for i, j in ((0, 1), (1, 2), (2, 0)):
                a, b = vertices[face[i]], vertices[face[j]]
                if (a[2] >= 0) != (b[2] >= 0):
                    points.append(a[:2] + a[2] / (a[2] - b[2]) * (b[:2] - a[:2]))
        if not points:
            return None
        return float(np.min(APERTURE / 2 - np.max(np.abs(np.asarray(points)), axis=1)))

    def arm(self, current, step, margin, support_loss_window):
        # Discard every intersection belonging to the qualifying supported
        # bridge.  The causal passage record starts only after physical
        # two-rib support is lost and the sampled whole-mesh plane section
        # first enters AP(0,0) within delta.
        self.previous = np.asarray(current)
        self.xy = []
        self.maximum_step_motion = 0.0
        self.armed = True
        self.attempt_id += 1
        self.arm_step = int(step)
        self.arm_margin_m = float(margin)
        # Bind the causal support-loss evidence to this attempt.  A shallow
        # copy is not enough because the force lists are mutable diagnostics.
        self.arm_support_loss_window = [
            {
                "drive_step": int(sample["drive_step"]),
                "contacted_rib_ids": list(sample["contacted_rib_ids"]),
                "rib_contact_force_magnitudes_N": list(sample["rib_contact_force_magnitudes_N"]),
            }
            for sample in support_loss_window
        ]

    def invalidate(self, current, step, reason):
        """End an armed attempt without carrying intersections into a later one."""
        if self.armed:
            self.invalidated_attempts.append({
                "attempt_id": self.attempt_id,
                "arm_step": self.arm_step,
                "invalidated_step": int(step),
                "reason": str(reason),
                "arming_support_loss_window": self.arm_support_loss_window,
                "sampled_intersection_count_discarded": len(self.xy),
            })
        self.previous = np.asarray(current)
        self.xy = []
        self.maximum_step_motion = 0.0
        self.armed = False

    def update(self, current, step):
        current = np.asarray(current)
        if not self.armed:
            self.previous = current
            return None
        # A vertex that was below the aperture plane and returns to/on it is
        # direct sampled evidence of upward re-entry.  End this attempt before
        # collecting any intersections so separate recrossings cannot be
        # combined.  This remains an endpoint-sampled predicate, not CCD.
        if np.any((self.previous[:, 2] < 0) & (current[:, 2] >= 0)):
            self.invalidate(current, step, "sampled_upward_plane_reentry")
            return None
        # Do not splice intersections across a non-monotonic attempt even
        # when no individual vertex happens to recross the plane in this
        # interval.  A later downward attempt must earn a new arm event and a
        # new fresh support-loss window.
        if float(np.mean(current[:, 2])) > float(np.mean(self.previous[:, 2])) + 1.0e-9:
            self.invalidate(current, step, "sampled_upward_center_motion")
            return None
        self.maximum_step_motion = max(self.maximum_step_motion,
                                       float(np.max(np.linalg.norm(current-self.previous, axis=1))))
        for a, b in zip(self.previous, current, strict=True):
            if a[2] >= 0 > b[2]: self.xy.append(a[:2] + a[2] / (a[2]-b[2]) * (b[:2]-a[:2]))
        for vertices in (self.previous, current):
            for face in self.faces:
                for i, j in ((0,1),(1,2),(2,0)):
                    a, b = vertices[face[i]], vertices[face[j]]
                    if (a[2] >= 0) != (b[2] >= 0):
                        self.xy.append(a[:2] + a[2] / (a[2]-b[2]) * (b[:2]-a[:2]))
        self.previous = current
        if not self.started_in_bridge_state or not np.all(current[:, 2] < 0): return None
        if not self.xy:
            self.armed = False
            return {"completed": True, "sampled_aperture_polygon_within_tolerance": False, "sampled_aperture_polygon_margin_m": -1.0,
                    "causal_crossing_arm_step": self.arm_step,
                    "causal_crossing_attempt_id": self.attempt_id,
                    "causal_crossing_arm_margin_m": self.arm_margin_m,
                    "causal_crossing_arming_support_loss_window": self.arm_support_loss_window,
                    "maximum_observed_endpoint_vertex_displacement_m": self.maximum_step_motion,
                    "sampled_clearance_minus_endpoint_displacement_m": -1.0}
        clearance = APERTURE/2 - np.max(np.abs(np.asarray(self.xy)), axis=1)
        # Endpoint displacement is not a bound on a rotating edge's swept path.
        sampled_resolution_margin = float(clearance.min()) - self.maximum_step_motion
        # This is the frozen numerical contact allowance, not a larger hole.
        self.armed = False
        return {"completed": True, "sampled_aperture_polygon_within_tolerance": bool(np.all(clearance >= -0.0005)),
                "sampled_aperture_polygon_margin_m": float(clearance.min()),
                "causal_crossing_arm_step": self.arm_step,
                "causal_crossing_attempt_id": self.attempt_id,
                "causal_crossing_arm_margin_m": self.arm_margin_m,
                "causal_crossing_arming_support_loss_window": self.arm_support_loss_window,
                "maximum_observed_endpoint_vertex_displacement_m": self.maximum_step_motion,
                "sampled_clearance_minus_endpoint_displacement_m": sampled_resolution_margin}


def main():
    dt = 1 / args.physics_hz
    sim = sim_utils.SimulationContext(sim_utils.SimulationCfg(dt=dt, device=args.device,
        render_interval=max(1, args.physics_hz // 20)))
    # The pinned PhysxManager disables contact processing during simulation
    # construction.  Applying PhysxContactReportAPI to actors is necessary but
    # does not reverse that global setting.  ContactSensor.__init__ normally
    # does so; this probe intentionally reads native collider-level reports
    # directly and therefore must perform the same verified settings operation
    # after SimulationContext construction and before the first reset/step.
    settings = get_settings_manager()
    contact_processing_disabled_before_enable = bool(
        settings.get("/physics/disableContactProcessing", True)
    )
    settings.set_bool("/physics/disableContactProcessing", False)
    contact_processing_disabled_readback = bool(
        settings.get("/physics/disableContactProcessing", True)
    )
    root, drive = spawn_moving_aperture(); mesh = media_mesh()
    # Rz(45)Ry(35).  The previous fully transverse (Ry(90)) seed was a stable
    # bridge under the bounded +/-5 degree screen drive and therefore never
    # exercised the crossing classifier.  This oblique seed still has a full
    # XY support span wider than the physical 12.7 mm aperture (checked after
    # native settling below), but has an end-first route through the unchanged
    # aperture once the physical screen drive breaks the bridge.
    a, b = math.radians(45)/2, math.radians(35)/2
    quat = (-math.sin(a)*math.sin(b), math.cos(a)*math.sin(b), math.sin(a)*math.cos(b), math.cos(a)*math.cos(b))
    rot = trimesh.transformations.quaternion_matrix((quat[3], *quat[:3]))[:3, :3]
    hz = float(np.max(np.abs((mesh.vertices @ rot.T)[:, 2])))
    body = RigidObject(RigidObjectCfg(prim_path="/World/Medium", spawn=spawn_mesh(mesh),
        init_state=RigidObjectCfg.InitialStateCfg(pos=(0, 0, ROOT_Z + hz + 1e-5), rot=quat)))
    aperture = RigidObject(RigidObjectCfg(prim_path="/World/MovingAperture", spawn=None))
    sensor = ContactSensor(ContactSensorCfg(
        prim_path="/World/Medium", update_period=0.0, history_length=0,
        track_air_time=False, filter_prim_paths_expr=["/World/MovingAperture"],
        max_contact_data_count_per_prim=32))
    rib_ids = [f"/World/MovingAperture/Rib_{i}" for i in range(4)]
    sim.reset(); body.reset(); aperture.reset(); native_dt = float(sim.get_physics_dt())
    stage = get_current_stage()
    raw_capacity = int(sensor.contact_view.max_contact_data_count)
    raw_totals = {key: 0 for key in ("total", "unique", "ambiguous", "unmapped",
                  "positive_force", "zero_force", "invalid_contacts", "invalid_fields", "saturated")}
    maximum_raw_count = 0
    raw_device = ""
    medium_ccd_attr = PhysxSchema.PhysxRigidBodyAPI(
        stage.GetPrimAtPath("/World/Medium")
    ).GetEnableCCDAttr()
    aperture_ccd_attr = PhysxSchema.PhysxRigidBodyAPI(
        stage.GetPrimAtPath("/World/MovingAperture")
    ).GetEnableCCDAttr()
    medium_ccd_enabled = bool(medium_ccd_attr.Get())
    aperture_ccd_enabled = bool(aperture_ccd_attr.Get())
    trace, gravity_speeds = [], []
    two_rib_consecutive = two_rib_max_consecutive = 0
    final_two_rib_ids = []
    settle_rib_contact_history = []
    for step in range(3 * args.physics_hz):
        sim.step(render=False); body.update(dt); aperture.update(dt)
        sensor.update(dt, force_recompute=True)
        ap, aq, av = pose(aperture)
        (contacted_rib_ids, rib_force_magnitudes, rib_point_counts,
         raw_contacts, accounting, raw_device) = raw_rib_contacts(sensor, ap, aq, raw_capacity)
        for key in raw_totals: raw_totals[key] += accounting[key]
        maximum_raw_count = max(maximum_raw_count, accounting["total"])
        settle_rib_contact_history.append({
            "settle_step": step + 1,
            "contacted_rib_ids": contacted_rib_ids,
            "rib_contact_force_magnitudes_N": rib_force_magnitudes,
            "rib_contact_point_counts": rib_point_counts,
            "raw_contact_count": accounting["total"],
            "raw_contact_accounting": accounting,
            "raw_contacts": raw_contacts,
        })
        if len(contacted_rib_ids) >= 2:
            two_rib_consecutive += 1
            two_rib_max_consecutive = max(two_rib_max_consecutive, two_rib_consecutive)
            final_two_rib_ids = contacted_rib_ids
        else:
            two_rib_consecutive = 0
            final_two_rib_ids = []
        p, q, v = pose(body); gravity_speeds.append(float(np.linalg.norm(v[:3])))
        hinge_angle, hinge_translation_residual, hinge_axis_residual = derived_hinge_state(ap, aq)
        trace.append({"phase":"settle", "step":step+1, "position_m":p.tolist(),
                      "quaternion_xyzw":q.tolist(), "velocity_mps_radps":v.tolist(),
                      "aperture_position_m":ap.tolist(), "aperture_quaternion_xyzw":aq.tolist(),
                      "aperture_velocity_mps_radps":av.tolist(),
                      "derived_native_relative_hinge_angle_deg":hinge_angle,
                      "hinge_frame_translation_residual_m":hinge_translation_residual,
                      "hinge_axis_rotation_residual_deg":hinge_axis_residual,
                      "rib_contact_force_magnitudes_N":rib_force_magnitudes,
                      "rib_contact_point_counts":rib_point_counts,
                      "raw_contact_count":accounting["total"],
                      "raw_contact_accounting":accounting,
                      "raw_contacts":raw_contacts,
                      "contacted_rib_ids":contacted_rib_ids,
                      "joint_drive_target_deg":0.0})
    initial = to_local_pose(ap, aq, world_vertices(body, mesh))
    retained_window_s = 0.5
    retained_window_samples = int(round(retained_window_s * args.physics_hz))
    raw_contact_fixture_valid = bool(
        two_rib_consecutive >= retained_window_samples and
        all(len(sample["contacted_rib_ids"]) >= 2
            for sample in settle_rib_contact_history[-retained_window_samples:])
    )
    bridged = bool(np.min(initial[:,2]) <= 0.001 and np.max(initial[:,2]) > 0 and
                   max(gravity_speeds[-retained_window_samples:]) < 0.005 and
                   np.ptp(initial[:,0]) > APERTURE and
                   two_rib_consecutive >= retained_window_samples and
                   raw_contact_fixture_valid)
    qualifying_rib_window = (settle_rib_contact_history[-retained_window_samples:]
                             if two_rib_consecutive >= retained_window_samples else [])
    qualifying_rib_id_union = sorted({rib_id for sample in qualifying_rib_window
                                      for rib_id in sample["contacted_rib_ids"]})
    qualifying_rib_id_sets = [sample["contacted_rib_ids"] for sample in qualifying_rib_window]
    qualifying_window_summary = {
        "required_consecutive_samples": retained_window_samples,
        "observed_consecutive_samples_at_settle_end": two_rib_consecutive,
        "window_start_settle_step": (qualifying_rib_window[0]["settle_step"]
                                     if qualifying_rib_window else -1),
        "window_end_settle_step": (qualifying_rib_window[-1]["settle_step"]
                                   if qualifying_rib_window else -1),
        "distinct_rib_ids_across_window": qualifying_rib_id_union,
        "contacted_rib_ids_per_sample": qualifying_rib_id_sets,
        "positive_raw_contact_fixture_every_sample": raw_contact_fixture_valid,
    }
    tracker, crossing, rolls = Crossing(initial, mesh.faces), None, []
    # A support-loss candidate is deliberately revocable.  It starts on the
    # first fresh native sample with fewer than two contacted ribs and is reset
    # on any two-rib re-contact; it is not a permanent release latch.
    release_candidate_start_step = None
    maximum_support_loss_consecutive = 0
    support_loss_consecutive = 0
    support_loss_window = []
    arming_support_loss_window = []
    drive_contact_history = []
    previous_local_center_z = float(np.mean(initial[:, 2]))
    for step in range(3 * args.physics_hz):
        t = step * dt
        # Match the frozen bridge protocol exactly: 5 degree, 1 Hz, two seconds.
        # This changes only the physical hinge-drive target; no task-object
        # state is written after reset.
        target = 5.0 * math.sin(2 * math.pi * t) if t < 2 else 0.0
        drive.GetTargetPositionAttr().Set(target)
        sim.step(render=False); body.update(dt); aperture.update(dt)
        sensor.update(dt, force_recompute=True)
        ap, aq, av = pose(aperture)
        (drive_contacted_rib_ids, drive_rib_force_magnitudes, drive_rib_point_counts,
         drive_raw_contacts, drive_accounting, raw_device) = raw_rib_contacts(
             sensor, ap, aq, raw_capacity)
        for key in raw_totals: raw_totals[key] += drive_accounting[key]
        maximum_raw_count = max(maximum_raw_count, drive_accounting["total"])
        drive_contact_history.append(drive_contacted_rib_ids)
        if len(drive_contacted_rib_ids) < 2:
            support_loss_consecutive += 1
            maximum_support_loss_consecutive = max(
                maximum_support_loss_consecutive, support_loss_consecutive)
            support_loss_window.append({
                "drive_step": step + 1,
                "contacted_rib_ids": drive_contacted_rib_ids,
                "rib_contact_force_magnitudes_N": drive_rib_force_magnitudes,
                "rib_contact_point_counts": drive_rib_point_counts,
            })
            if release_candidate_start_step is None:
                release_candidate_start_step = step + 1
        else:
            # Recovery of two-rib support ends an already armed attempt as
            # well as revoking an unarmed candidate.  Its intersections must
            # never be carried into a later release/crossing attempt.
            support_loss_consecutive = 0
            support_loss_window = []
            release_candidate_start_step = None
        roll, hinge_translation_residual, hinge_axis_residual = derived_hinge_state(ap, aq)
        rolls.append(roll)
        p, q, v = pose(body); local = to_local_pose(ap, aq, world_vertices(body, mesh))
        local_center_z = float(np.mean(local[:, 2]))
        local_center_downward = local_center_z < previous_local_center_z
        section_margin = tracker.section_margin(local)
        # A completed crossing is immutable.  Continue sampling the physical
        # trace, but never invalidate or arm another classifier attempt whose
        # fields could be combined with the retained completion.
        if crossing is None and tracker.armed and len(drive_contacted_rib_ids) >= 2:
            tracker.invalidate(local, step + 1, "two_rib_support_recovered")
        if (crossing is None and not tracker.armed and bridged and support_loss_consecutive >= 1 and
                section_margin is not None and section_margin >= -0.0005 and local_center_downward):
            arming_support_loss_window = list(support_loss_window)
            tracker.arm(local, step + 1, section_margin, arming_support_loss_window)
        elif crossing is None:
            crossing = tracker.update(local, step + 1)
        trace.append({"phase":"drive", "step":step+1, "observed_roll_deg":roll,
                      "position_m":p.tolist(), "quaternion_xyzw":q.tolist(),
                      "velocity_mps_radps":v.tolist(), "aperture_position_m":ap.tolist(),
                      "aperture_quaternion_xyzw":aq.tolist(),
                      "aperture_velocity_mps_radps":av.tolist(),
                      "derived_native_relative_hinge_angle_deg":roll,
                      "hinge_frame_translation_residual_m":hinge_translation_residual,
                      "hinge_axis_rotation_residual_deg":hinge_axis_residual,
                      "contacted_rib_ids":drive_contacted_rib_ids,
                      "release_candidate_start_step":release_candidate_start_step,
                      "fresh_consecutive_support_loss_samples":support_loss_consecutive,
                      "rib_contact_force_magnitudes_N":drive_rib_force_magnitudes,
                      "rib_contact_point_counts":drive_rib_point_counts,
                      "raw_contact_count":drive_accounting["total"],
                      "raw_contact_accounting":drive_accounting,
                      "raw_contacts":drive_raw_contacts,
                      "sampled_plane_section_margin_m":section_margin,
                      "medium_center_z_in_aperture_frame_m":local_center_z,
                      "medium_center_downward_in_aperture_frame":local_center_downward,
                      "causal_crossing_armed":tracker.armed,
                      "causal_crossing_attempt_id":tracker.attempt_id,
                      "invalidated_crossing_attempt_count":len(tracker.invalidated_attempts),
                      "joint_drive_target_deg":target})
        previous_local_center_z = local_center_z
    numeric_trace = [x["position_m"] + x["quaternion_xyzw"] + x["velocity_mps_radps"] +
                     x["aperture_position_m"] + x["aperture_quaternion_xyzw"] +
                     x["aperture_velocity_mps_radps"] +
                     [x["derived_native_relative_hinge_angle_deg"],
                      x["hinge_frame_translation_residual_m"],
                      x["hinge_axis_rotation_residual_deg"], x["joint_drive_target_deg"]]
                     for x in trace]
    finite = bool(np.isfinite(np.asarray(numeric_trace)).all())
    report_path = args.report if args.report.is_absolute() else (Path.cwd()/args.report).resolve()
    report_path.parent.mkdir(parents=True, exist_ok=True)
    trace_path = report_path.with_name(report_path.stem + "-trace.json.gz")
    with gzip.open(trace_path, "wt", encoding="utf-8") as f:
        json.dump({"scope":"single-seed sampled moving-frame crossing discovery only",
                   "retained_window_s":retained_window_s,
                   "native_contact_processing_setting":{
                       "path":"/physics/disableContactProcessing",
                       "disabled_before_explicit_enable":contact_processing_disabled_before_enable,
                       "disabled_after_explicit_enable_readback":contact_processing_disabled_readback,
                       "settings_manager_omniverse_mode":bool(settings.is_omniverse_mode),
                   },
                   "native_physx_ccd_readback":{
                       "/World/Medium":medium_ccd_enabled,
                       "/World/MovingAperture":aperture_ccd_enabled,
                   },
                   "coverage":"completed-physics-sample endpoints only; no continuous swept-geometry claim",
                   "rib_contact_observable":"native Warp raw contact points transformed by each completed sample's observed aperture pose; uniquely mapped finite positive-force 3-D rib-face contacts only",
                   "crossing_classifier":"ideal fixed aperture polygon at sampled endpoints; not actual-rib signed distance, physical clearance, genuine passage, or continuous swept coverage",
                   "rib_ids":rib_ids, "final_bridge_contacted_rib_ids":final_two_rib_ids,
                   "raw_contact_device":raw_device,
                   "raw_contact_capacity":raw_capacity,
                   "raw_contact_accounting":raw_totals,
                   "maximum_raw_contacts_in_one_sample":maximum_raw_count,
                   "current_release_candidate_start_step":release_candidate_start_step,
                   "maximum_fresh_consecutive_support_loss_samples":maximum_support_loss_consecutive,
                   "arming_support_loss_window":(crossing["causal_crossing_arming_support_loss_window"] if crossing else arming_support_loss_window),
                   "causal_crossing_arm_step":(crossing["causal_crossing_arm_step"] if crossing else tracker.arm_step),
                   "causal_crossing_arm_margin_m":(crossing["causal_crossing_arm_margin_m"] if crossing else tracker.arm_margin_m),
                   "invalidated_crossing_attempts":tracker.invalidated_attempts,
                   "drive_contacted_rib_ids_per_sample":drive_contact_history,
                   "qualifying_two_rib_contact_window":qualifying_window_summary,
                   "maximum_consecutive_two_distinct_rib_contact_samples":two_rib_max_consecutive,
                   "samples":trace, "crossing":crossing, "bridged":bridged}, f, separators=(",", ":"))
    workspace = Path(__file__).resolve().parent.parent
    checks = [
        {"name":"physics_dt_absolute_error","measured":abs(native_dt-dt),"operator":"<=","threshold":1e-9,"unit":"s"},
        {"name":"finite_native_samples","measured":int(finite),"operator":"==","threshold":1,"unit":"bool"},
        {"name":"medium_native_physx_ccd_enabled","measured":int(medium_ccd_enabled),"operator":"==","threshold":1,"unit":"bool"},
        {"name":"moving_aperture_native_physx_ccd_enabled","measured":int(aperture_ccd_enabled),"operator":"==","threshold":1,"unit":"bool"},
        {"name":"contact_processing_enabled_readback_before_first_reset","measured":int(not contact_processing_disabled_readback),"operator":"==","threshold":1,"unit":"bool"},
        {"name":"settings_manager_omniverse_mode","measured":int(settings.is_omniverse_mode),"operator":"==","threshold":1,"unit":"bool"},
        {"name":"fresh_physics_sample_count","measured":len(trace),"operator":"==","threshold":6*args.physics_hz,"unit":"completed_physics_samples"},
        {"name":"cuda_backed_raw_contact_points","measured":int(raw_device.startswith("cuda")),"operator":"==","threshold":1,"unit":"bool"},
        {"name":"populated_raw_contact_points","measured":raw_totals["total"],"operator":">","threshold":0,"unit":"points"},
        {"name":"uniquely_mapped_raw_contact_points","measured":raw_totals["unique"],"operator":">","threshold":0,"unit":"points"},
        {"name":"positive_force_raw_contact_points","measured":raw_totals["positive_force"],"operator":">","threshold":0,"unit":"points"},
        {"name":"raw_contact_classification_sum_difference","measured":abs(raw_totals["total"]-raw_totals["unique"]-raw_totals["ambiguous"]-raw_totals["unmapped"]),"operator":"==","threshold":0,"unit":"points"},
        {"name":"invalid_populated_raw_contact_fields","measured":raw_totals["invalid_fields"],"operator":"==","threshold":0,"unit":"fields"},
        {"name":"invalid_populated_raw_contacts","measured":raw_totals["invalid_contacts"],"operator":"==","threshold":0,"unit":"contacts"},
        {"name":"raw_contact_buffer_saturated_samples","measured":raw_totals["saturated"],"operator":"==","threshold":0,"unit":"completed_physics_samples"},
        {"name":"maximum_raw_contacts_strictly_below_capacity","measured":maximum_raw_count,"operator":"<","threshold":raw_capacity,"unit":"points"},
        {"name":"positive_raw_contact_fixture_for_support_loss_interpretation","measured":int(raw_contact_fixture_valid),"operator":"==","threshold":1,"unit":"bool"},
        {"name":"gravity_retained_oblique_seed_with_fresh_two_distinct_rib_support","measured":int(bridged),"operator":"==","threshold":1,"unit":"bool"},
        {"name":"maximum_consecutive_two_distinct_rib_contact_samples","measured":two_rib_max_consecutive,"operator":">=","threshold":retained_window_samples,"unit":"completed_physics_samples"},
        {"name":"observed_roll_range","measured":max(rolls)-min(rolls),"operator":">=","threshold":8.0,"unit":"deg"},
        {"name":"physical_two_rib_support_loss_observed_after_qualified_bridge","measured":int(
            bridged and maximum_support_loss_consecutive > 0
        ),"operator":"==","threshold":1,"unit":"bool"},
        {"name":"causal_crossing_window_armed_during_fresh_support_loss","measured":int(
            crossing is not None and
            bool(crossing["causal_crossing_arming_support_loss_window"]) and
            crossing["causal_crossing_arming_support_loss_window"][-1]["drive_step"] == crossing["causal_crossing_arm_step"] and
            len(crossing["causal_crossing_arming_support_loss_window"][-1]["contacted_rib_ids"]) < 2
        ),"operator":"==","threshold":1,"unit":"bool"},
        {"name":"sampled_ideal_aperture_polygon_crossing_within_tolerance","measured":int(bool(crossing and crossing["sampled_aperture_polygon_within_tolerance"])),"operator":"==","threshold":1,"unit":"bool"},
        {"name":"minimum_sampled_ideal_aperture_polygon_margin","measured":float(crossing["sampled_aperture_polygon_margin_m"] if crossing else -1),"operator":">=","threshold":-0.0005,"unit":"m"},
        # Diagnostic only.  Endpoint motion is explicitly not used as a
        # conservative rotational swept-volume bound.
        {"name":"maximum_observed_endpoint_vertex_displacement","measured":float(crossing["maximum_observed_endpoint_vertex_displacement_m"] if crossing else tracker.maximum_step_motion),"operator":">=","threshold":0.0,"unit":"m_per_completed_physics_interval"},
        {"name":"maximum_hinge_frame_translation_residual","measured":max(x["hinge_frame_translation_residual_m"] for x in trace),"operator":"<=","threshold":0.0005,"unit":"m"},
        {"name":"maximum_hinge_axis_rotation_residual","measured":max(x["hinge_axis_rotation_residual_deg"] for x in trace),"operator":"<=","threshold":0.5,"unit":"deg"},
        {"name":"native_aperture_state_samples","measured":len(trace),"operator":"==","threshold":6*args.physics_hz,"unit":"completed_physics_samples"},
    ]
    with report_path.open("w", encoding="utf-8") as f:
        json.dump({
            "scope":"single-seed sampled moving-frame crossing discovery only",
            "coverage":"completed-physics-sample endpoints only; no continuous swept-geometry claim",
            "rib_contact_observable":"native Warp raw contact points transformed by each completed sample's observed aperture pose; uniquely mapped finite positive-force 3-D rib-face contacts only",
            "crossing_classifier":"ideal fixed aperture polygon at sampled endpoints; not actual-rib signed distance, physical clearance, genuine passage, or continuous swept coverage",
            "qualification_claimed":False,
            "native_contact_processing_setting":{
                "path":"/physics/disableContactProcessing",
                "disabled_before_explicit_enable":contact_processing_disabled_before_enable,
                "disabled_after_explicit_enable_readback":contact_processing_disabled_readback,
                "settings_manager_omniverse_mode":bool(settings.is_omniverse_mode),
            },
            "raw_contact_device":raw_device,
            "raw_contact_capacity":raw_capacity,
            "raw_contact_accounting":raw_totals,
            "qualifying_two_rib_contact_window":qualifying_window_summary,
            "arming_support_loss_window":(crossing["causal_crossing_arming_support_loss_window"] if crossing else arming_support_loss_window),
            "checks":checks,
            "artifacts":[trace_path.relative_to(workspace).as_posix()],
        }, f, indent=2)
    simulation_app.close()


if __name__ == "__main__": main()
