#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    bool physics:rigidBodyEnabled = true
    float physics:mass = 0.06
    point3f physics:centerOfMass = (0, 0, 0.045)
    float3 physics:diagonalInertia = (0.000041, 0.000041, 0.000002)
    def Cylinder "Handle" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.09
        double radius = 0.008
        double3 xformOp:translate = (0, 0, 0.045)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.12, 0.18, 0.72)]
    }
}
