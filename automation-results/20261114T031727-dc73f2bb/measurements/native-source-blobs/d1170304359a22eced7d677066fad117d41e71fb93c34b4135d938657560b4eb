#!/usr/bin/env python3
"""Native loaded compliant-mimic probe for the frozen DRG80 thread law.

This bounded preflight follows the honestly failed free-release energy
bookkeeping probe.  It does not reinterpret that result and does not qualify
the gripper environment.  The actual positive-compliance mimic is placed in
the already validated carrier/bilateral-plate load-cell coupon.  Native plate
contact force, native DOF velocity, extension and applied torque are sampled
under bidirectional loading.
A positive-compliance native PhysX articulation mimic realizes

    e = z - p*theta, U = 0.5*K*e**2,
    K = 1e6 N/m, D = 4000 N*s/m, p = 0.001/(2*pi) m/rad.

K and D are identified from an integrator-consistent generalized-impulse
balance.  For every completed step, the balance subtracts the measured change
in native generalized momentum and the native applied/contact impulses.  The
resulting internal mimic impulse is independently reconstructed from the axial
and rotational equations before its elastic part is removed.  Thus plate
constraint impulse, carrier/rotor inertia, and applied torque are not silently
called damping.  Damping work uses this internal impulse and the trapezoidal
native DOF rate.  Release energy closure includes contact and applied work.
Position-increment disagreement and any remaining projection/resolution loss
are reported, and energy-closure error is a hard pass criterion.
The mimic uses zero velocity iterations: the
pinned shared PhysX solver's velocity-iteration branch hard-projects relative
velocity even for positive compliance, which made D unobservable in the failed
four-velocity-iteration trial.  No pose, velocity, or joint-state writes occur
after reset.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import math
from pathlib import Path
import sys
import traceback
import uuid

from isaaclab.app import AppLauncher


parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--output", required=True)
parser.add_argument("--trace", required=True)
AppLauncher.add_app_launcher_args(parser)
args = parser.parse_args()

output_path = Path(args.output).resolve()
trace_path = Path(args.trace).resolve()
for product in (output_path, trace_path):
    product.parent.mkdir(parents=True, exist_ok=True)
    product.unlink(missing_ok=True)

trial_id = str(uuid.uuid4())
source_sha256 = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
app = AppLauncher(args).app
SAMPLES: list[dict] = []
METADATA: dict = {}


import numpy as np
import torch
import warp as wp

import isaaclab.sim as sim_utils
from isaaclab_physx.physics import PhysxManager
from pxr import Gf, PhysxSchema, UsdGeom, UsdPhysics


DT = 1.0 / 240.0
LEAD_M_PER_REV = 0.001
P_M_PER_RAD = LEAD_M_PER_REV / (2.0 * math.pi)
K_N_PER_M = 1.0e6
D_NS_PER_M = 4000.0
CARRIER_MASS_KG = 0.01
ROTOR_MASS_KG = 0.01
ROTOR_INERTIA_KG_M2 = 1.0e-6
SETTLE_STEPS = 480
IDENTIFY_STEPS = 1440
HOLD_STEPS = 480
RELEASE_STEPS = 480
TEST_TORQUE_NM = 0.005
AXIAL_LIMIT_M = 0.005
ROTATION_LIMIT_RAD = math.radians(1440.0)
AXIAL_LIMIT_CLEARANCE_MIN_M = 5.0e-4
ROTATION_LIMIT_CLEARANCE_MIN_RAD = 1.0
POSITION_ITERATIONS = 128
VELOCITY_ITERATIONS = 0
MIMIC_AXIS = "rotZ"
CONSTITUTIVE_RELATIVE_ERROR_MAX = 0.10
REACTION_CHANNEL_RELATIVE_RMSE_MAX = 0.10
ENERGY_BALANCE_RELATIVE_ERROR_MAX = 0.25
# For native C=theta-z/p, kp_C=K*p^2 and kd_C=D*p^2.  The shared
# CPU/GPU PhysX mimic solver uses kp=mu^2/r and kd=2*mu*zeta/r.  These
# values follow from the declared bare-mechanism mass matrix, not tuning.
ANALYTIC_M_AXIAL = CARRIER_MASS_KG + ROTOR_MASS_KG
ANALYTIC_M_ROTATION = ROTOR_INERTIA_KG_M2
ANALYTIC_R = (1.0 / P_M_PER_RAD**2) / ANALYTIC_M_AXIAL + 1.0 / ANALYTIC_M_ROTATION
KP_C = K_N_PER_M * P_M_PER_RAD**2
KD_C = D_NS_PER_M * P_M_PER_RAD**2
MIMIC_NATURAL_FREQUENCY_S_INV = math.sqrt(KP_C * ANALYTIC_R)
MIMIC_DAMPING_RATIO = KD_C * ANALYTIC_R / (
    2.0 * MIMIC_NATURAL_FREQUENCY_S_INV
)


def write_json(path: Path, payload: dict) -> None:
    path.write_text(
        json.dumps(payload, indent=2, sort_keys=True, allow_nan=False) + "\n",
        encoding="utf-8",
    )


def safe_number(value: float) -> float | str:
    number = float(value)
    if math.isnan(number):
        return "NaN"
    if math.isinf(number):
        return "Infinity" if number > 0.0 else "-Infinity"
    return number


def json_safe(value):
    if isinstance(value, dict):
        return {key: json_safe(item) for key, item in value.items()}
    if isinstance(value, (list, tuple)):
        return [json_safe(item) for item in value]
    if isinstance(value, (float, np.floating)):
        return safe_number(value)
    return value


def check(name: str, measured: float, operator: str, threshold: float, unit: str) -> dict:
    value = float(measured)
    comparisons = {
        "==": lambda a, b: a == b,
        ">=": lambda a, b: a >= b,
        "<=": lambda a, b: a <= b,
        ">": lambda a, b: a > b,
        "<": lambda a, b: a < b,
    }
    passed = math.isfinite(value) and comparisons[operator](value, float(threshold))
    return {
        "name": name,
        "measured": safe_number(value),
        "operator": operator,
        "threshold": threshold,
        "unit": unit,
        "passed": bool(passed),
    }


def create_link(stage, name: str, mass_kg: float, inertia: float, *, collision=False):
    cube = UsdGeom.Cube.Define(stage, f"/World/Thread/{name}")
    cube.CreateSizeAttr(0.01)
    cube.AddTranslateOp().Set(Gf.Vec3d(0.0, 0.0, 0.5))
    UsdPhysics.RigidBodyAPI.Apply(cube.GetPrim())
    if collision:
        UsdPhysics.CollisionAPI.Apply(cube.GetPrim())
        PhysxSchema.PhysxContactReportAPI.Apply(cube.GetPrim()).CreateThresholdAttr(0.0)
    mass = UsdPhysics.MassAPI.Apply(cube.GetPrim())
    mass.CreateMassAttr(mass_kg)
    mass.CreateDiagonalInertiaAttr(Gf.Vec3f(inertia, inertia, inertia))
    PhysxSchema.PhysxRigidBodyAPI.Apply(cube.GetPrim()).CreateDisableGravityAttr(True)
    return cube.GetPath()


def create_plate(stage, name: str, z_m: float):
    plate = UsdGeom.Cube.Define(stage, f"/World/{name}")
    plate.CreateSizeAttr(1.0)
    plate.AddTranslateOp().Set(Gf.Vec3d(0.0, 0.0, z_m))
    plate.AddScaleOp().Set(Gf.Vec3f(0.05, 0.05, 0.004))
    body = UsdPhysics.RigidBodyAPI.Apply(plate.GetPrim())
    UsdPhysics.CollisionAPI.Apply(plate.GetPrim())
    UsdPhysics.MassAPI.Apply(plate.GetPrim()).CreateMassAttr(100.0)
    PhysxSchema.PhysxRigidBodyAPI.Apply(plate.GetPrim()).CreateDisableGravityAttr(True)
    body.CreateKinematicEnabledAttr(True)
    PhysxSchema.PhysxContactReportAPI.Apply(plate.GetPrim()).CreateThresholdAttr(0.0)
    return plate.GetPath()


def as_torch(value) -> torch.Tensor:
    return wp.to_torch(value).detach().cpu().clone()


def main() -> None:
    global METADATA
    sim = sim_utils.SimulationContext(sim_utils.SimulationCfg(dt=DT, device=args.device))
    stage = sim.stage

    root = UsdGeom.Xform.Define(stage, "/World/Thread")
    UsdPhysics.ArticulationRootAPI.Apply(root.GetPrim())
    articulation_api = PhysxSchema.PhysxArticulationAPI.Apply(root.GetPrim())
    articulation_api.CreateSolverPositionIterationCountAttr(POSITION_ITERATIONS)
    articulation_api.CreateSolverVelocityIterationCountAttr(VELOCITY_ITERATIONS)

    frame = create_link(stage, "frame", 1.0, 1.0e-3)
    carrier = create_link(stage, "carrier", CARRIER_MASS_KG, 1.0e-6, collision=True)
    rotor = create_link(stage, "rotor", ROTOR_MASS_KG, ROTOR_INERTIA_KG_M2)

    contact_offset = 0.005 + 0.002
    lower_plate = create_plate(stage, "LowerPlate", 0.5 - contact_offset)
    upper_plate = create_plate(stage, "UpperPlate", 0.5 + contact_offset)

    mount = UsdPhysics.FixedJoint.Define(stage, "/World/Thread/mount")
    mount.CreateBody1Rel().SetTargets([frame])
    mount.CreateLocalPos0Attr(Gf.Vec3f(0.0, 0.0, 0.5))

    axial = UsdPhysics.PrismaticJoint.Define(stage, "/World/Thread/axial")
    axial.CreateBody0Rel().SetTargets([frame])
    axial.CreateBody1Rel().SetTargets([carrier])
    axial.CreateAxisAttr("Z")
    axial.CreateLowerLimitAttr(-AXIAL_LIMIT_M)
    axial.CreateUpperLimitAttr(AXIAL_LIMIT_M)

    rotation = UsdPhysics.RevoluteJoint.Define(stage, "/World/Thread/rotation")
    rotation.CreateBody0Rel().SetTargets([carrier])
    rotation.CreateBody1Rel().SetTargets([rotor])
    rotation.CreateAxisAttr("Z")
    rotation.CreateLowerLimitAttr(-math.degrees(ROTATION_LIMIT_RAD))
    rotation.CreateUpperLimitAttr(math.degrees(ROTATION_LIMIT_RAD))

    # Installed native discovery established that the revolute coordinate is
    # authored in degrees for this schema and that -360000 degree/metre gives
    # the required one-millimetre lead.  Positive compliance is derived from
    # the frozen physical K,D and bare-mechanism inverse mass response.
    mimic = PhysxSchema.PhysxMimicJointAPI.Apply(rotation.GetPrim(), MIMIC_AXIS)
    mimic.CreateReferenceJointRel().SetTargets([axial.GetPath()])
    mimic.CreateReferenceJointAxisAttr("rotX")
    mimic.CreateGearingAttr(-360.0 / LEAD_M_PER_REV)
    mimic.CreateOffsetAttr(0.0)
    mimic.CreateNaturalFrequencyAttr(MIMIC_NATURAL_FREQUENCY_S_INV)
    mimic.CreateDampingRatioAttr(MIMIC_DAMPING_RATIO)

    sim.reset()
    physics = PhysxManager.get_physics_sim_view()
    if physics is None:
        raise RuntimeError("native PhysX simulation view unavailable after reset")
    physics.set_subspace_roots("/")
    articulation = physics.create_articulation_view("/World/Thread")
    if articulation.count != 1 or articulation.max_dofs != 2:
        raise RuntimeError(
            f"unexpected articulation shape {articulation.count}x{articulation.max_dofs}"
        )
    dof_names = list(articulation.get_metatype(0).dof_names)
    axial_index = dof_names.index("axial")
    rotation_index = dof_names.index("rotation")
    all_indices = wp.array([0], dtype=wp.uint32, device=args.device)
    carrier_view = physics.create_rigid_body_view([str(carrier)])
    contact_view = physics.create_rigid_contact_view(
        [str(carrier)],
        filter_patterns=[[str(lower_plate), str(upper_plate)]],
        max_contact_data_count=32,
    )
    if carrier_view.count != 1 or contact_view.sensor_count != 1 or contact_view.filter_count != 2:
        raise RuntimeError(
            "unexpected native load-cell views: "
            f"carrier={carrier_view.count}, "
            f"contact=({contact_view.sensor_count},{contact_view.filter_count})"
        )

    authored_frequency = float(mimic.GetNaturalFrequencyAttr().Get())
    authored_damping_ratio = float(mimic.GetDampingRatioAttr().Get())
    authored_gearing = float(mimic.GetGearingAttr().Get())
    authored_position_iterations = int(
        articulation_api.GetSolverPositionIterationCountAttr().Get()
    )
    authored_velocity_iterations = int(
        articulation_api.GetSolverVelocityIterationCountAttr().Get()
    )
    METADATA = {
        "native_trial_id": trial_id,
        "source_sha256": source_sha256,
        "scope": "positive-compliance mimic native contact/load-cell preflight only",
        "dof_names": dof_names,
        "physics_dt_s": DT,
        "thread_stiffness_n_per_m": K_N_PER_M,
        "thread_damping_ns_per_m": D_NS_PER_M,
        "lead_m_per_revolution": LEAD_M_PER_REV,
        "test_rotor_torque_nm": TEST_TORQUE_NM,
        "contact_filter_paths": list(contact_view.filter_paths),
        "analytic_inverse_mass_response": ANALYTIC_R,
        "kp_constraint_coordinate": KP_C,
        "kd_constraint_coordinate": KD_C,
        "authored_mimic_natural_frequency_s_inverse": authored_frequency,
        "authored_mimic_damping_ratio": authored_damping_ratio,
        "authored_mimic_gearing_degree_per_metre": authored_gearing,
        "authored_solver_position_iterations": authored_position_iterations,
        "authored_solver_velocity_iterations": authored_velocity_iterations,
    }

    def persist_raw_trace(status: str) -> None:
        # Phase-boundary persistence keeps genuine native observations even if
        # a later SDK getter or validation fails.
        write_json(
            trace_path,
            json_safe({**METADATA, "status": status, "samples": SAMPLES}),
        )

    def set_effort(rotor_torque_nm: float) -> None:
        efforts = torch.zeros(
            (articulation.count, articulation.max_dofs),
            dtype=torch.float32,
            device=args.device,
        )
        efforts[0, axial_index] = 0.0
        efforts[0, rotation_index] = rotor_torque_nm
        articulation.set_dof_actuation_forces(
            wp.from_torch(efforts.contiguous(), dtype=wp.float32), all_indices
        )

    def capture(phase: str, phase_step: int, commanded_torque_nm: float) -> bool:
        q = as_torch(articulation.get_dof_positions())[0]
        qd = as_torch(articulation.get_dof_velocities())[0]
        efforts = as_torch(articulation.get_dof_actuation_forces())[0]
        mass_matrix = as_torch(articulation.get_generalized_mass_matrices())[0]
        expected_shape = (articulation.max_dofs, articulation.max_dofs)
        if tuple(mass_matrix.shape) != expected_shape:
            raise RuntimeError(
                f"unexpected generalized mass-matrix shape {tuple(mass_matrix.shape)}"
            )
        z = float(q[axial_index])
        theta = float(q[rotation_index])
        zd = float(qd[axial_index])
        thetad = float(qd[rotation_index])
        extension = z - P_M_PER_RAD * theta
        extension_rate = zd - P_M_PER_RAD * thetad
        kinetic_energy = 0.5 * float(qd @ mass_matrix @ qd)
        contact_matrix = as_torch(
            contact_view.get_contact_force_matrix(dt=DT)
        ).reshape(1, 2, 3)[0]
        contact_impulse_matrix = as_torch(
            contact_view.get_contact_force_matrix(dt=1.0)
        ).reshape(1, 2, 3)[0]
        signed_contact_force = float(contact_matrix[:, 2].sum())
        signed_contact_impulse = float(contact_impulse_matrix[:, 2].sum())
        carrier_transform = as_torch(carrier_view.get_transforms())[0]
        values = np.asarray(
            [
                *q.tolist(),
                *qd.tolist(),
                *efforts.tolist(),
                *mass_matrix.flatten().tolist(),
                extension,
                extension_rate,
                kinetic_energy,
                *contact_matrix.flatten().tolist(),
                *contact_impulse_matrix.flatten().tolist(),
                signed_contact_force,
                signed_contact_impulse,
                *carrier_transform.tolist(),
            ],
            dtype=np.float64,
        )
        SAMPLES.append(
            {
                "phase": phase,
                "phase_step": phase_step,
                "dof_positions": q.tolist(),
                "dof_velocities": qd.tolist(),
                "dof_actuation_forces": efforts.tolist(),
                "generalized_mass_matrix": mass_matrix.tolist(),
                "commanded_rotor_torque_nm": commanded_torque_nm,
                "extension_m": extension,
                "extension_rate_m_s": extension_rate,
                "kinetic_energy_j": kinetic_energy,
                "contact_force_matrix_n": contact_matrix.tolist(),
                "contact_impulse_matrix_ns": contact_impulse_matrix.tolist(),
                "signed_carrier_contact_force_n": signed_contact_force,
                "signed_carrier_contact_impulse_ns": signed_contact_impulse,
                "carrier_transform_xyzw": carrier_transform.tolist(),
            }
        )
        return bool(np.all(np.isfinite(values)))

    all_finite = True
    for phase, steps in (
        ("settle", SETTLE_STEPS),
        ("identify", IDENTIFY_STEPS),
        ("positive_hold", HOLD_STEPS),
        ("released_mid", RELEASE_STEPS),
        ("negative_hold", 2 * HOLD_STEPS),
        ("released_final", RELEASE_STEPS),
    ):
        for phase_step in range(steps):
            if phase == "identify":
                # Three non-harmonic components make extension and native rate
                # independently observable without writing any state.
                time_s = phase_step * DT
                torque_nm = TEST_TORQUE_NM * (
                    0.60 * math.sin(2.0 * math.pi * 5.0 * time_s)
                    + 0.30 * math.sin(2.0 * math.pi * 17.0 * time_s)
                    + 0.10 * math.sin(2.0 * math.pi * 31.0 * time_s)
                )
            elif phase == "positive_hold":
                torque_nm = TEST_TORQUE_NM
            elif phase == "negative_hold":
                torque_nm = -TEST_TORQUE_NM
            else:
                torque_nm = 0.0
            set_effort(torque_nm)
            sim.step(render=False)
            all_finite = capture(phase, phase_step, torque_nm) and all_finite
            if not all_finite:
                break
        if not all_finite:
            break
        persist_raw_trace(f"captured_{phase}")

    q = np.asarray([sample["dof_positions"] for sample in SAMPLES], dtype=np.float64)
    qd = np.asarray([sample["dof_velocities"] for sample in SAMPLES], dtype=np.float64)
    efforts = np.asarray(
        [sample["dof_actuation_forces"] for sample in SAMPLES], dtype=np.float64
    )
    mass_matrices = np.asarray(
        [sample["generalized_mass_matrix"] for sample in SAMPLES], dtype=np.float64
    )
    extension = np.asarray([sample["extension_m"] for sample in SAMPLES], dtype=np.float64)
    commanded = np.asarray(
        [sample["commanded_rotor_torque_nm"] for sample in SAMPLES], dtype=np.float64
    )
    contact_force = np.asarray(
        [sample["signed_carrier_contact_force_n"] for sample in SAMPLES],
        dtype=np.float64,
    )
    contact_matrices = np.asarray(
        [sample["contact_force_matrix_n"] for sample in SAMPLES], dtype=np.float64
    )
    contact_impulse = np.asarray(
        [sample["signed_carrier_contact_impulse_ns"] for sample in SAMPLES],
        dtype=np.float64,
    )
    carrier_transforms = np.asarray(
        [sample["carrier_transform_xyzw"] for sample in SAMPLES], dtype=np.float64
    )
    finite_values = np.column_stack(
        (
            q,
            qd,
            efforts,
            extension,
            contact_force,
            contact_impulse,
            contact_matrices.reshape(len(SAMPLES), -1),
            carrier_transforms,
            mass_matrices.reshape(len(SAMPLES), -1),
        )
    )
    finite_fraction = float(np.isfinite(finite_values).mean()) if finite_values.size else 0.0
    identify_start = SETTLE_STEPS
    positive_hold_start = identify_start + IDENTIFY_STEPS
    release_mid_start = positive_hold_start + HOLD_STEPS
    negative_hold_start = release_mid_start + RELEASE_STEPS
    release_start = negative_hold_start + 2 * HOLD_STEPS
    expected_sample_count = release_start + RELEASE_STEPS
    have_complete_trace = len(SAMPLES) == expected_sample_count

    # Reconstruct the native mimic reaction from the discrete generalized
    # impulse balance.  With e=z-p*theta and positive constitutive force F,
    # Q_mimic=[-F,+pF].  For completed interval k:
    #   M_k v_k - M_{k-1} v_{k-1} = J_contact + tau_applied*dt + J_mimic.
    # The axial and rotational equations therefore provide independent F
    # observations.  This explicitly accounts for carrier/rotor inertia and
    # the complete resolved plate-contact impulse instead of treating their
    # residual as damping.
    generalized_momentum = np.einsum("nij,nj->ni", mass_matrices, qd)
    momentum_delta = generalized_momentum[1:] - generalized_momentum[:-1]
    axial_mimic_force = (
        contact_impulse[1:]
        + efforts[1:, axial_index] * DT
        - momentum_delta[:, axial_index]
    ) / DT
    rotational_mimic_force = (
        momentum_delta[:, rotation_index] - efforts[1:, rotation_index] * DT
    ) / (P_M_PER_RAD * DT)
    midpoint_extension = 0.5 * (extension[:-1] + extension[1:])
    extension_rate = qd[:, axial_index] - P_M_PER_RAD * qd[:, rotation_index]
    midpoint_extension_rate = 0.5 * (extension_rate[:-1] + extension_rate[1:])

    identify_indices = np.arange(identify_start + 1, positive_hold_start, dtype=np.int64)
    positive_settled = np.arange(release_mid_start - 120, release_mid_start, dtype=np.int64)
    negative_settled = np.arange(release_start - 120, release_start, dtype=np.int64)
    hold_indices = np.concatenate((positive_settled, negative_settled))
    identify_intervals = identify_indices - 1
    scaled_design = np.column_stack(
        (
            K_N_PER_M * midpoint_extension[identify_intervals],
            D_NS_PER_M * midpoint_extension_rate[identify_intervals],
        )
    )
    response = axial_mimic_force[identify_intervals]
    singular_values = np.linalg.svd(scaled_design, compute_uv=False)
    design_condition = float(singular_values[0] / max(singular_values[-1], 1e-30))
    # K is measured in a settled constant-load window where the damping term
    # is negligible.  Holding that measured K fixed, D is identified from the
    # independent multi-frequency transient window.  This prevents a single
    # ill-conditioned two-parameter fit from trading stiffness for damping.
    settled_intervals = hold_indices - 1
    settled_force = axial_mimic_force[settled_intervals]
    settled_extension = midpoint_extension[settled_intervals]
    inferred_k = float(
        np.dot(settled_extension, settled_force)
        / max(float(np.dot(settled_extension, settled_extension)), 1e-30)
    )
    damping_response = response - inferred_k * midpoint_extension[identify_intervals]
    transient_rate = midpoint_extension_rate[identify_intervals]
    inferred_d = float(
        np.dot(transient_rate, damping_response)
        / max(float(np.dot(transient_rate, transient_rate)), 1e-30)
    )
    settled_extension_rate_max = float(np.max(np.abs(extension_rate[hold_indices])))
    transient_extension_rate_rms = float(np.sqrt(np.mean(transient_rate**2)))
    constitutive_prediction = (
        inferred_k * midpoint_extension + inferred_d * midpoint_extension_rate
    )
    fit_residual = response - constitutive_prediction[identify_intervals]
    fit_relative_rmse = float(np.sqrt(np.mean(fit_residual**2))) / max(
        float(np.sqrt(np.mean(response**2))), 1e-12
    )
    stiffness_relative_error = abs(inferred_k - K_N_PER_M) / K_N_PER_M
    damping_relative_error = abs(inferred_d - D_NS_PER_M) / D_NS_PER_M
    reaction_channel_error = (
        axial_mimic_force[identify_intervals]
        - rotational_mimic_force[identify_intervals]
    )
    reaction_channel_relative_rmse = float(
        np.sqrt(np.mean(reaction_channel_error**2))
    ) / max(float(np.sqrt(np.mean(response**2))), 1e-12)

    measured_elastic_energy = 0.5 * inferred_k * extension**2
    measured_kinetic_energy = np.asarray(
        [sample["kinetic_energy_j"] for sample in SAMPLES], dtype=np.float64
    )
    measured_energy = measured_elastic_energy + measured_kinetic_energy
    measured_damping_impulse = (
        axial_mimic_force - inferred_k * midpoint_extension
    ) * DT
    measured_damping_power = (
        measured_damping_impulse / DT * midpoint_extension_rate
    )
    for index, sample in enumerate(SAMPLES):
        sample["measured_elastic_energy_j"] = float(measured_elastic_energy[index])
        sample["measured_mechanical_energy_j"] = float(measured_energy[index])
        if index > 0:
            interval = index - 1
            sample["native_axial_balance_mimic_force_n"] = float(
                axial_mimic_force[interval]
            )
            sample["native_rotational_balance_mimic_force_n"] = float(
                rotational_mimic_force[interval]
            )
            sample["measured_constitutive_force_n"] = float(
                constitutive_prediction[interval]
            )
            sample["native_balance_damping_impulse_ns"] = float(
                measured_damping_impulse[interval]
            )
            sample["native_balance_damping_power_w"] = float(
                measured_damping_power[interval]
            )

    if have_complete_trace:
        baseline_extension = abs(float(extension[release_start - 1]))
        baseline_energy = float(measured_energy[release_start - 1])
        release_extension = np.abs(extension[release_start:])
        release_energy = measured_energy[release_start:]
        peak_extension_ratio = float(np.max(release_extension)) / max(baseline_extension, 1e-15)
        final_extension_ratio = float(release_extension[-1]) / max(baseline_extension, 1e-15)
        peak_energy_ratio = float(np.max(release_energy)) / max(baseline_energy, 1e-15)
        # Each entry k in the balance arrays represents sample interval
        # [k,k+1].  Contact/applied work and internal damping work are paired
        # with trapezoidal native generalized rates for that same interval.
        interval_indices = np.arange(release_start, expected_sample_count)
        balance_indices = interval_indices - 1
        native_interval_rate = midpoint_extension_rate[balance_indices]
        released_native_damping_work = float(
            np.sum(measured_damping_impulse[balance_indices] * native_interval_rate)
        )
        released_expected_damping_work = float(
            np.sum(D_NS_PER_M * native_interval_rate**2 * DT)
        )
        midpoint_axial_rate = 0.5 * (
            qd[interval_indices - 1, axial_index]
            + qd[interval_indices, axial_index]
        )
        midpoint_rotational_rate = 0.5 * (
            qd[interval_indices - 1, rotation_index]
            + qd[interval_indices, rotation_index]
        )
        released_contact_work = float(
            np.sum(contact_impulse[interval_indices] * midpoint_axial_rate)
        )
        released_applied_work = float(
            np.sum(
                efforts[interval_indices, axial_index] * midpoint_axial_rate * DT
                + efforts[interval_indices, rotation_index]
                * midpoint_rotational_rate
                * DT
            )
        )
        released_external_work = released_contact_work + released_applied_work
        position_increment_rate = (
            extension[interval_indices] - extension[interval_indices - 1]
        ) / DT
        projection_rate_rms = float(
            np.sqrt(np.mean((position_increment_rate - native_interval_rate) ** 2))
        )
        observed_release_energy_loss = baseline_energy - float(release_energy[-1])
        energy_balance_residual = (
            observed_release_energy_loss
            - (released_native_damping_work - released_external_work)
        )
        energy_balance_relative_error = abs(energy_balance_residual) / max(
            abs(observed_release_energy_loss),
            abs(released_native_damping_work - released_external_work),
            1e-15,
        )
        damping_work_relative_error = abs(
            released_native_damping_work - released_expected_damping_work
        ) / max(abs(released_expected_damping_work), 1e-15)
    else:
        baseline_extension = 0.0
        baseline_energy = 0.0
        peak_extension_ratio = math.inf
        final_extension_ratio = math.inf
        peak_energy_ratio = math.inf
        released_native_damping_work = 0.0
        released_expected_damping_work = 0.0
        released_contact_work = 0.0
        released_applied_work = 0.0
        released_external_work = 0.0
        projection_rate_rms = math.inf
        observed_release_energy_loss = 0.0
        energy_balance_residual = math.inf
        energy_balance_relative_error = math.inf
        damping_work_relative_error = math.inf

    axial_effort_error = float(np.max(np.abs(efforts[:, axial_index])))
    rotor_effort_error = float(np.max(np.abs(efforts[:, rotation_index] - commanded)))
    positive_contact_mean = float(np.mean(contact_force[positive_settled]))
    negative_contact_mean = float(np.mean(contact_force[negative_settled]))
    carrier_axial_motion = float(
        np.max(np.abs(carrier_transforms[:, 2] - carrier_transforms[0, 2]))
    )
    contact_transverse_peak = float(
        np.max(np.linalg.norm(contact_matrices[:, :, :2].sum(axis=1), axis=1))
    )
    unloaded_contact_bias = float(np.mean(contact_force[SETTLE_STEPS - 120:SETTLE_STEPS]))
    impulse_force_dt_error = float(
        np.max(np.abs(contact_impulse - contact_force * DT))
    )
    mass_symmetry_error = float(
        np.max(np.abs(mass_matrices - np.swapaxes(mass_matrices, 1, 2)))
    )
    mass_matrix_variation = float(
        np.max(np.abs(mass_matrices - mass_matrices[0]))
    )
    min_mass_eigenvalue = float(
        np.min(
            np.linalg.eigvalsh(
                0.5 * (mass_matrices + np.swapaxes(mass_matrices, 1, 2))
            )
        )
    )
    axial_clearance = float(np.min(AXIAL_LIMIT_M - np.abs(q[:, axial_index])))
    rotation_clearance = float(np.min(ROTATION_LIMIT_RAD - np.abs(q[:, rotation_index])))
    actual_dt = float(sim.get_physics_dt())
    initial_mass_matrix = mass_matrices[0]
    constraint_jacobian = np.asarray([-1.0 / P_M_PER_RAD, 1.0])
    native_inverse_mass_response = float(
        constraint_jacobian @ np.linalg.inv(initial_mass_matrix) @ constraint_jacobian
    )
    native_mapped_frequency = math.sqrt(KP_C * native_inverse_mass_response)
    native_mapped_damping_ratio = (
        KD_C
        * native_inverse_mass_response
        / (2.0 * native_mapped_frequency)
    )
    analytic_mass_matrix = np.diag([ANALYTIC_M_AXIAL, ANALYTIC_M_ROTATION])
    initial_mass_matrix_error = float(
        np.max(np.abs(initial_mass_matrix - analytic_mass_matrix))
    )
    frequency_mapping_relative_error = abs(
        authored_frequency - native_mapped_frequency
    ) / native_mapped_frequency
    damping_mapping_relative_error = abs(
        authored_damping_ratio - native_mapped_damping_ratio
    ) / native_mapped_damping_ratio
    gearing_error = abs(authored_gearing + 360.0 / LEAD_M_PER_REV)

    checks = [
        check("native_articulation_count", articulation.count, "==", 1, "articulations"),
        check("native_dof_count", articulation.max_dofs, "==", 2, "dofs"),
        check("native_collision_shape_count", articulation.max_shapes, "==", 1, "shapes"),
        check("native_contact_sensor_count", contact_view.sensor_count, "==", 1, "bodies"),
        check("native_contact_filter_count", contact_view.filter_count, "==", 2, "bodies"),
        check("authored_solver_position_iterations", authored_position_iterations, "==", POSITION_ITERATIONS, "iterations"),
        check("authored_solver_velocity_iterations", authored_velocity_iterations, "==", 0, "iterations"),
        check("actual_physics_dt_absolute_error", abs(actual_dt - DT), "<=", 1e-9, "s"),
        check("fresh_native_sample_count", len(SAMPLES), "==", expected_sample_count, "physics steps"),
        check("native_state_finite_fraction", finite_fraction, "==", 1.0, "fraction"),
        check("initial_native_mass_matrix_error_max", initial_mass_matrix_error, "<=", 1e-7, "mixed SI generalized inertia"),
        check("mimic_gearing_readback_error", gearing_error, "<=", 1e-3, "degree/m"),
        check("native_mass_mapped_frequency_relative_error", frequency_mapping_relative_error, "<=", 1e-3, "fraction"),
        check("native_mass_mapped_damping_ratio_relative_error", damping_mapping_relative_error, "<=", 1e-3, "fraction"),
        check("generalized_mass_matrix_symmetry_error_max", mass_symmetry_error, "<=", 1e-7, "mixed SI generalized inertia"),
        check("generalized_mass_matrix_variation_max", mass_matrix_variation, "<=", 1e-7, "mixed SI generalized inertia"),
        check("generalized_mass_matrix_eigenvalue_min", min_mass_eigenvalue, ">", 0.0, "mixed SI generalized inertia"),
        check("axial_joint_limit_clearance_min", axial_clearance, ">=", AXIAL_LIMIT_CLEARANCE_MIN_M, "m"),
        check("rotation_joint_limit_clearance_min", rotation_clearance, ">=", ROTATION_LIMIT_CLEARANCE_MIN_RAD, "rad"),
        check("native_applied_axial_excitation_error_max", axial_effort_error, "<=", 5e-6, "N"),
        check("native_applied_rotor_excitation_error_max", rotor_effort_error, "<=", 5e-9, "N*m"),
        check("positive_contact_reaction_magnitude_min", abs(positive_contact_mean), ">=", 1.0, "N"),
        check("negative_contact_reaction_magnitude_min", abs(negative_contact_mean), ">=", 1.0, "N"),
        check("bidirectional_contact_reaction_sign_product", positive_contact_mean * negative_contact_mean, "<", 0.0, "N^2"),
        check("carrier_axial_restraint_motion_max", carrier_axial_motion, "<=", 5e-4, "m"),
        check("contact_transverse_force_peak_max", contact_transverse_peak, "<=", 0.1, "N"),
        check("unloaded_signed_contact_bias_max", abs(unloaded_contact_bias), "<=", 0.1, "N"),
        check("contact_impulse_force_dt_error_max", impulse_force_dt_error, "<=", 1e-6, "N*s"),
        check("constitutive_identification_design_condition_max", design_condition, "<=", 100.0, "condition number"),
        check("settled_extension_rate_max", settled_extension_rate_max, "<=", 1e-6, "m/s"),
        check("transient_extension_rate_rms_min", transient_extension_rate_rms, ">=", 1e-6, "m/s"),
        check("native_inferred_stiffness_relative_error", stiffness_relative_error, "<=", CONSTITUTIVE_RELATIVE_ERROR_MAX, "fraction"),
        check("native_inferred_damping_relative_error", damping_relative_error, "<=", CONSTITUTIVE_RELATIVE_ERROR_MAX, "fraction"),
        check("native_constitutive_fit_relative_rmse", fit_relative_rmse, "<=", CONSTITUTIVE_RELATIVE_ERROR_MAX, "fraction"),
        check("native_axial_rotational_reaction_relative_rmse", reaction_channel_relative_rmse, "<=", REACTION_CHANNEL_RELATIVE_RMSE_MAX, "fraction"),
        check("pre_release_hold_extension_magnitude_min", baseline_extension, ">=", 1e-7, "m"),
        check("pre_release_hold_mechanical_energy_min", baseline_energy, ">", 0.0, "J"),
        check("released_peak_extension_ratio_max", peak_extension_ratio, "<=", 2.0, "ratio"),
        check("released_peak_mechanical_energy_ratio_max", peak_energy_ratio, "<=", 1.05, "ratio"),
        check("released_final_extension_ratio_max", final_extension_ratio, "<=", 0.1, "ratio"),
        check("released_native_balance_damping_work_min", released_native_damping_work, ">", 0.0, "J"),
        check("released_native_vs_declared_damping_work_relative_error", damping_work_relative_error, "<=", CONSTITUTIVE_RELATIVE_ERROR_MAX, "fraction"),
        check("released_energy_balance_relative_error", energy_balance_relative_error, "<=", ENERGY_BALANCE_RELATIVE_ERROR_MAX, "fraction"),
        check("released_projection_rate_rms_finite", math.isfinite(projection_rate_rms), "==", 1.0, "boolean"),
    ]
    write_json(
        trace_path,
        json_safe(
            {
                **METADATA,
                "status": "validation_complete",
                "actual_physics_dt_s": actual_dt,
                "release_baseline_sample_index": release_start - 1,
                "constitutive_identification": {
                    "inferred_stiffness_n_per_m": inferred_k,
                    "inferred_damping_ns_per_m": inferred_d,
                    "fit_relative_rmse": fit_relative_rmse,
                    "design_condition": design_condition,
                    "settled_window_sample_indices": hold_indices.tolist(),
                    "transient_window_sample_indices": identify_indices.tolist(),
                    "settled_extension_rate_max_m_s": settled_extension_rate_max,
                    "transient_extension_rate_rms_m_s": transient_extension_rate_rms,
                    "axial_rotational_reaction_relative_rmse": reaction_channel_relative_rmse,
                    "released_native_balance_damping_work_j": released_native_damping_work,
                    "released_declared_law_damping_work_j": released_expected_damping_work,
                    "released_damping_work_relative_error": damping_work_relative_error,
                    "released_damping_work_method": "discrete native generalized-momentum balance after subtracting complete resolved contact and applied impulses; elastic midpoint impulse removed; result dotted with trapezoidal native extension rate",
                    "released_contact_work_j": released_contact_work,
                    "released_applied_work_j": released_applied_work,
                    "released_external_work_j": released_external_work,
                    "observed_release_energy_loss_j": observed_release_energy_loss,
                    "energy_balance_residual_j": energy_balance_residual,
                    "energy_balance_relative_error": energy_balance_relative_error,
                    "position_increment_minus_native_rate_rms_m_s": projection_rate_rms,
                    "energy_balance_is_pass_criterion": True,
                },
                "samples": SAMPLES,
            }
        ),
    )
    write_json(
        output_path,
        {
            "native_trial_id": trial_id,
            "source_sha256": source_sha256,
            "qualification": False,
            "actual_physics_dt_s": actual_dt,
            "checks": checks,
            "overall_pass": all(item["passed"] for item in checks),
            "artifacts": [str(trace_path.relative_to(output_path.parent.parent))],
        },
    )
    if not all(item["passed"] for item in checks):
        raise RuntimeError(
            "positive-compliance mimic contact/load-cell preflight failed: "
            + ", ".join(item["name"] for item in checks if not item["passed"])
        )


if __name__ == "__main__":
    try:
        main()
    except Exception:
        detail = traceback.format_exc()
        print(detail, file=sys.stderr, flush=True)
        if not trace_path.exists():
            write_json(
                trace_path,
                json_safe(
                    {
                        **METADATA,
                        "native_trial_id": trial_id,
                        "source_sha256": source_sha256,
                        "scope": "positive-compliance mimic native contact/load-cell preflight only",
                        "status": "runtime_exception",
                        "error": detail,
                        "samples": SAMPLES,
                    }
                ),
            )
        if not output_path.exists():
            write_json(
                output_path,
                {
                    "native_trial_id": trial_id,
                    "source_sha256": source_sha256,
                    "qualification": False,
                    "error": detail,
                    "checks": [
                        {
                            "name": "native_probe_completed",
                            "measured": 0.0,
                            "operator": "==",
                            "threshold": 1.0,
                            "unit": "boolean",
                            "passed": False,
                        }
                    ],
                    "overall_pass": False,
                    "artifacts": [str(trace_path.relative_to(output_path.parent.parent))],
                },
            )
        raise
    finally:
        app.close()
